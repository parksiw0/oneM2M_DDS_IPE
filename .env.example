# Copy to .env. Compose uses host networking; see DOCKER_COMPOSE.md for Mac setup.
IPE_RUN_MODE=run
# 1: TurtleBot /odom + /cmd_vel demo; 0: existing config.py mapping.
IPE_DEMO=1

# TinyIoT running on the Mac itself (or this Linux Docker host):
IPE_CSE_ENDPOINT=http://127.0.0.1:3000
IPE_CSE_POA=http://127.0.0.1:5050
# TinyIoT on a separate Linux PC: use that PC's LAN IP for ENDPOINT,
# and the Mac's LAN IP for POA. The CSE must be able to reach POA on port 5050.
# IPE_CSE_ENDPOINT=http://192.168.0.10:3000
# IPE_CSE_POA=http://192.168.0.20:5050

IPE_ROS_DOMAIN_ID=30
# Empty: discover the robot's DDS vendor. For the current Fast DDS TurtleBot:
# IPE_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
IPE_RMW_IMPLEMENTATION=
# Existing Cyclone DDS peer option; it is not a Docker Desktop NAT workaround.
IPE_ROS_PEER=
IPE_GRAPH_TIMEOUT_SEC=30

# Optional Live Sync broker. Run it on the same host as TinyIoT.
# Loopback is sufficient when TinyIoT and the browser also run on that host.
# For a remote CSE, publish on the CSE host's LAN IP for the Mac browser.
DEMO_MQTT_BIND_IP=127.0.0.1
